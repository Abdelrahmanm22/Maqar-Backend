@model Maqar.Admin.ViewModels.PropertyFormViewModel
@{
    ViewData["Title"] = "Edit Property";
}

<link href="~/back/assets/libs/dropzone/min/dropzone.min.css" rel="stylesheet" type="text/css" />

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                    <div>
                        <h4 class="card-title mb-1">Edit Property <span class="text-muted">#@Model.Id</span></h4>
                        <p class="text-muted mb-0">Image changes (cover, order, remove) save immediately; everything else saves with the form.</p>
                    </div>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-soft-info btn-sm"><i class="bx bx-show me-1"></i> View details</a>
                </div>

                <form asp-action="Edit" method="post" enctype="multipart/form-data" id="property-form">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="Id" />

                    <partial name="_PropertyForm" model="Model" />

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="bx bx-check me-1"></i> Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/back/assets/libs/dropzone/min/dropzone.min.js"></script>
    <script src="~/back/assets/js/property-form.js"></script>
    <script src="~/back/assets/js/property-images.js"
            data-action-base="@Url.Content("~/Property/")"
            data-property-id="@Model.Id"></script>
}

@model Maqar.Admin.ViewModels.PropertyFormViewModel
@{
    ViewData["Title"] = "New Property";
}

<link href="~/back/assets/libs/dropzone/min/dropzone.min.css" rel="stylesheet" type="text/css" />

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card">
            <div class="card-body">
                <div class="mb-4">
                    <h4 class="card-title mb-1">New Property</h4>
                    <p class="text-muted mb-0">Saved as a draft — publish it from its details page when it's ready.</p>
                </div>

                <form asp-action="Create" method="post" enctype="multipart/form-data" id="property-form">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <partial name="_PropertyForm" model="Model" />

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="bx bx-check me-1"></i> Save Property</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/back/assets/libs/dropzone/min/dropzone.min.js"></script>
    <script src="~/back/assets/js/property-form.js"></script>
    <script src="~/back/assets/js/property-images.js"></script>
}

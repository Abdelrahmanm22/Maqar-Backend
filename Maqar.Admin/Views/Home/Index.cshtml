@model Maqar.Admin.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-xl-4">
        <div class="card overflow-hidden">
            <div class="bg-primary bg-soft">
                <div class="row">
                    <div class="col-7">
                        <div class="text-primary p-4">
                            <h5 class="text-primary mb-1">Welcome back, @(User.Identity?.Name) 👋</h5>
                            <p class="mb-0">Maqar — Properties Hub Administration</p>
                        </div>
                    </div>
                    <div class="col-5 align-self-center text-end pe-3">
                        <img src="~/back/assets/images/Logo_Maqar.png" alt="Maqar Admin" class="img-fluid" style="max-height:90px;">
                    </div>
                </div>
            </div>
            <div class="card-body pt-0">
                <p class="text-muted mt-3 mb-0">
                    Manage Maqar's listings, users and roles from one place.
                    @if (Model.ShowStats)
                    {
                        <span>Engagement below covers the last @Maqar.Admin.ViewModels.DashboardViewModel.Days days@(Model.IsScoped ? " on your listings" : "").</span>
                    }
                </p>
            </div>
        </div>
    </div>

    @if (Model.ShowStats)
    {
        <div class="col-xl-8">
            <div class="row">
                @{
                    var cards = new[]
                    {
                        (Label: "Listing views", Value: Model.Totals.Views, Icon: "bx-show", Css: "primary"),
                        (Label: "WhatsApp taps", Value: Model.Totals.WhatsAppClicks, Icon: "bxl-whatsapp", Css: "success"),
                        (Label: "Call taps", Value: Model.Totals.CallClicks, Icon: "bx-phone", Css: "info"),
                    };
                }
                @foreach (var card in cards)
                {
                    <div class="col-md-4">
                        <div class="card mini-stats-wid">
                            <div class="card-body">
                                <div class="d-flex">
                                    <div class="flex-grow-1">
                                        <p class="text-muted fw-medium mb-1">@card.Label</p>
                                        <h4 class="mb-0">@card.Value.ToString("N0")</h4>
                                    </div>
                                    <div class="avatar-sm rounded-circle bg-@card.Css-subtle align-self-center">
                                        <span class="avatar-title rounded-circle bg-transparent text-@card.Css font-size-24">
                                            <i class="bx @card.Icon"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (Model.ShowStats)
{
    <div class="row">
        <div class="col-xl-6">
            <partial name="_TopProperties" model="@(("Most viewed", "bx-show", "views", Model.MostViewed))" />
        </div>
        <div class="col-xl-6">
            <partial name="_TopProperties" model="@(("Most contacted (WhatsApp + calls)", "bx-phone-call", "taps", Model.MostContacted))" />
        </div>
    </div>
}

@using Maqar.Admin.Helpers
@using Maqar.Domain.Enums
@model Maqar.Admin.ViewModels.ContactMessageListViewModel
@{
    ViewData["Title"] = "Contact Messages";
    var f = Model.Filters;
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h4 class="card-title mb-1">Contact Messages</h4>
                        <p class="text-muted mb-0">
                            @(Model.CanViewAll
                                ? "Every message from the public site — the contact form and listing inquiries."
                                : "Inquiries about the listings you have added.")
                        </p>
                    </div>
                    <form method="get" asp-action="Index" class="d-flex gap-2">
                        @if (f.Status is not null)
                        {
                            <input type="hidden" name="Status" value="@f.Status" />
                        }
                        <div class="position-relative">
                            <input type="text" class="form-control ps-5" name="Search" value="@f.Search" placeholder="Name, email, phone or text" />
                            <i class="bx bx-search-alt position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
                        </div>
                        <button type="submit" class="btn btn-primary"><i class="bx bx-search-alt"></i></button>
                    </form>
                </div>

                @* Status tabs — plain links, so they keep the search and are bookmarkable. *@
                <ul class="nav nav-tabs nav-tabs-custom mb-3">
                    <li class="nav-item">
                        <a class="nav-link @(f.Status is null ? "active" : "")" asp-action="Index" asp-route-Search="@f.Search">All</a>
                    </li>
                    @foreach (var s in Enum.GetValues<ContactMessageStatus>())
                    {
                        <li class="nav-item">
                            <a class="nav-link @(f.Status == s ? "active" : "")" asp-action="Index" asp-route-Status="@s" asp-route-Search="@f.Search">
                                @PropertyBadges.ForMessage(s).Label
                                @if (s == ContactMessageStatus.New && Model.NewCount > 0)
                                {
                                    <span class="badge bg-danger rounded-pill ms-1">@Model.NewCount</span>
                                }
                            </a>
                        </li>
                    }
                </ul>

                @if (Model.Page.Count == 0)
                {
                    <div class="text-center text-muted py-5">
                        <i class="bx bx-envelope font-size-24 d-block mb-2"></i>
                        No messages here.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>From</th>
                                    <th>Message</th>
                                    <th>About</th>
                                    <th>Received</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.Page.Data)
                                {
                                    var badge = PropertyBadges.ForMessage(m.Status);
                                    <tr class="@(m.Status == ContactMessageStatus.New ? "fw-semibold" : "")" role="button"
                                        onclick="location.href='@Url.Action("Details", new { id = m.Id })'">
                                        <td class="text-nowrap">
                                            <div>@m.Name</div>
                                            <div class="text-muted font-size-12 fw-normal">@m.Email</div>
                                        </td>
                                        <td class="min-width-0"><div class="text-truncate" style="max-width:380px">@m.Message</div></td>
                                        <td class="text-nowrap fw-normal">
                                            @if (m.Property is not null)
                                            {
                                                <span class="text-truncate d-inline-block align-middle" style="max-width:200px">
                                                    <i class="bx bx-building-house text-primary me-1"></i>@m.Property.TitleEn
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">General</span>
                                            }
                                        </td>
                                        <td class="text-nowrap fw-normal text-muted">@m.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                        <td><span class="badge @badge.CssClass"><i class="bx @badge.Icon me-1"></i>@badge.Label</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <partial name="_Pager" model="PagerViewModel.From(Model.Page)" />
                }
            </div>
        </div>
    </div>
</div>

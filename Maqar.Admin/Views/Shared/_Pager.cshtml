@using Microsoft.AspNetCore.Http.Extensions
@model Maqar.Admin.ViewModels.PagerViewModel
@*
    Server-side pager. Every link keeps the current query string (filters, sort) and only swaps PageIndex,
    so paging never drops a filter. Renders nothing for a single page.
*@
@{
    string PageUrl(int page)
    {
        var query = Context.Request.Query
            .Where(q => !string.Equals(q.Key, "PageIndex", StringComparison.OrdinalIgnoreCase))
            .SelectMany(q => q.Value.Select(v => new KeyValuePair<string, string?>(q.Key, v)))
            .Append(new KeyValuePair<string, string?>("PageIndex", page.ToString()));
        return Context.Request.Path + QueryString.Create(query).ToUriComponent();
    }

    var first = Math.Max(1, Model.PageIndex - 2);
    var last = Math.Min(Model.TotalPages, Model.PageIndex + 2);
    var from = Model.Count == 0 ? 0 : (Model.PageIndex - 1) * Model.PageSize + 1;
    var to = Math.Min(Model.Count, Model.PageIndex * Model.PageSize);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
    <div class="text-muted font-size-13">
        Showing <strong>@from</strong>–<strong>@to</strong> of <strong>@Model.Count</strong>
    </div>

    @if (Model.TotalPages > 1)
    {
        <ul class="pagination pagination-rounded mb-0">
            <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                <a class="page-link" href="@PageUrl(Model.PageIndex - 1)" aria-label="Previous"><i class="bx bx-chevron-left"></i></a>
            </li>
            @if (first > 1)
            {
                <li class="page-item"><a class="page-link" href="@PageUrl(1)">1</a></li>
                @if (first > 2)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }
            @for (var p = first; p <= last; p++)
            {
                <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                    <a class="page-link" href="@PageUrl(p)">@p</a>
                </li>
            }
            @if (last < Model.TotalPages)
            {
                @if (last < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item"><a class="page-link" href="@PageUrl(Model.TotalPages)">@Model.TotalPages</a></li>
            }
            <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@PageUrl(Model.PageIndex + 1)" aria-label="Next"><i class="bx bx-chevron-right"></i></a>
            </li>
        </ul>
    }
</div>
